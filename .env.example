# Wajib: API key OpenAI dari https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-isi_api_key_anda

# Model default yang cepat dan hemat untuk chat harian. Ubah sesuai akses akun Anda.
OPENAI_MODEL=gpt-5.4-mini

# Model dan opsi untuk command !gambar.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=low

# Instruksi kepribadian bot.
BOT_SYSTEM_PROMPT=Kamu adalah asisten WhatsApp yang ramah, ringkas, dan membantu. Jawab dalam bahasa yang sama dengan pengguna.

# Prefix opsional. Jika kosong, bot membalas semua chat pribadi dan hanya membalas grup saat disebut/di-prefix.
BOT_PREFIX=!

# Batasi jumlah pesan percakapan yang disimpan per chat.
MAX_HISTORY_MESSAGES=12

# Batas download !music dan !video agar aman untuk Termux/WhatsApp.
MAX_DOWNLOAD_DURATION_SECONDS=600
MAX_AUDIO_MB=25
MAX_VIDEO_MB=45

# Jika true, bot akan ikut memproses pesan yang dikirim dari akun sendiri.
REPLY_FROM_ME=false
